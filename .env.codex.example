# Codex CLI (commande !codex)
# Ajoutez CODEX_API_KEY dans les variables Railway, jamais dans le depot.
CODEX_API_KEY=
CODEX_BASE_URL=https://api.freemodel.dev
CODEX_MODEL=gpt-5.5
CODEX_REASONING_EFFORT=xhigh
CODEX_FILE_REASONING_EFFORT=high
CODEX_TIMEOUT_MS=600000
CODEX_FILE_TIMEOUT_MS=1200000

# Optionnel: chemin explicite du CLI. Le paquet local est utilise par defaut.
CODEX_BIN=
